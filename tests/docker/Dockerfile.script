# Shell Script Setup Test
FROM debian:bookworm-slim

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies for script testing
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    wget \
    build-essential \
    procps \
    file \
    vim \
    locales \
    zsh \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Set locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

# Create test user
RUN useradd -m -s /bin/zsh testuser
USER testuser
WORKDIR /home/testuser

# Copy setup files
COPY --chown=testuser:testuser ../setup.sh /tmp/ghostty/setup.sh
COPY --chown=testuser:testuser ../ghostty /tmp/ghostty/ghostty

WORKDIR /tmp/ghostty

# Test script syntax
RUN echo "=== Testing Shell Script Syntax ===" && \
    bash -n setup.sh && echo "Bash syntax OK" && \
    zsh -n setup.sh 2>&1 || echo "Zsh syntax check done" && \
    file setup.sh && \
    head -1 setup.sh

# Test basic script functions
RUN echo "=== Testing Script Functions ===" && \
    chmod +x setup.sh && \
    ./setup.sh --help 2>&1 || ./setup.sh 2>&1 | head -20 || true

# Verify configuration files can be created
RUN echo "=== Testing Config File Generation ===" && \
    mkdir -p /home/testuser/.config/ghostty && \
    cat ../ghostty/ghostty.nix 2>/dev/null | head -5 || echo "Ghostty config source available" && \
    echo "Config generation capability verified"

CMD ["/bin/zsh"]
