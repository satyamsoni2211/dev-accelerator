# Ghostty Terminal Setup - Homebrew Dependencies
# Run: brew bundle install

# Terminal
cask "ghostty"

# Version control
brew "git"
brew "gh"

# Shell
brew "zsh"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Fuzzy finder and utilities
brew "fzf"
brew "fd"
brew "zoxide"
brew "yazi"
brew "ripgrep"

# snippet tool very handy
brew "knqyf263/pet/pet"

# Shell enhancements
brew "atuin"
brew "starship"
brew "thefuck"
brew "direnv"

# Node.js managers
brew "mise"
brew "fnm"

# Python tools
brew "uv"

# JSON processor
brew "jq"

# Modern CLI tools
brew "eza"
brew "bat"
brew "htop"