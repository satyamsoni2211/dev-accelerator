# Ghostty Terminal Setup - Homebrew Dependencies
# Run: brew bundle install

# Terminal
cask "ghostty"

# Version control (git assumed pre-installed)
brew "gh"

# Shell (zsh assumed pre-installed)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Fuzzy finder and utilities
brew "fzf"
brew "fd"
brew "zoxide"
brew "yazi"
brew "ripgrep"

# snippet tool very handy
# brew "knqyf263/pet/pet"

# Shell enhancements
brew "atuin"
brew "starship"
brew "thefuck"
brew "direnv"

# Node.js managers
brew "mise"
brew "fnm"

# Python tools
brew "pyenv"
brew "uv"

# JSON processor
brew "jq"

# Modern CLI tools
brew "eza"
brew "bat"
brew "htop"

# New productivity tools (2025/2026)
brew "bottom"      # Modern system monitor (htop alternative)
brew "tealdeer"    # Fast tldr client
brew "delta"       # Git pager with syntax highlighting
brew "tokei"       # Code statistics
brew "zellij"      # Terminal workspace (tmux alternative)
brew "gitui"       # Git TUI
brew "procs"       # Modern ps replacement
brew "ouch"        # All-in-one compression tool